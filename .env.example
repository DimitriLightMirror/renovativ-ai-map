# Renovativ AI Map — environment variables (example).
# Copy this file to .env.local (gitignored) and fill in real values.
# NEVER commit real keys.

# Denmark — Lassox hosted BBR wrapper (https://docs.lassox.com/data-apis/bbr/)
# Auth header: lasso-api-key. Not yet available.
VITE_LASSOX_API_KEY=

# Denmark — enable the Lassox data source on map clicks (default OFF).
VITE_USE_LASSOX_DENMARK=false

# Denmark — Lassox demo property override (defaults: 79972 / 157 Gentofte).
# VITE_LASSOX_DEMO_PROPERTY=
# VITE_LASSOX_DEMO_MUNICIPALITY=

# Denmark — Datafordeler direct BBR access (https://api.datafordeler.dk). Scaffolded.
VITE_DATAFORDELER_API_KEY=

# Denmark — EMO energy labels (https://ens.dk/analyser-og-statistik/energimaerkningsdata).
# Key requested from emo-info@ens.dk, pending as of 2026-07-24. Scaffolded.
VITE_EMO_API_KEY=
