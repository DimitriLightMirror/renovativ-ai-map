# Renovativ AI Map — local secrets (copy to .env.local, which is gitignored).
# NEVER commit real credentials.

# Denmark pipeline (scripts/fetch-denmark.mjs) — Danish Energy Agency
# (Energistyrelsen) EMOData API. Basic-auth account obtained from Energistyrelsen.
# Base: https://emoweb.dk/EMOData/EMOData.svc
EMO_USER=
EMO_PASS=

# London pipeline (scripts/fetch-london.mjs) — MHCLG Energy Certificate Data API
# bearer token (free registration at get-energy-performance-data.communities.gov.uk).
EPC_API_TOKEN=

# Optional knobs
# FETCH_BUDGET_S=240   # detail-fetch time budget per run (pipelines are resumable)
